# ==============================================================================
# Environment Configuration - Online Exam Proctoring Platform
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# Application General
ENVIRONMENT=development
PROJECT_NAME="Online Exam Proctoring Platform"
API_V1_STR=/api/v1

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=exam_proctoring_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend Database URLs (Constructed automatically if left empty)
# Async URL for FastAPI asyncpg: postgresql+asyncpg://postgres:postgres_password@postgres:5432/exam_proctoring_db
# Sync URL for Alembic migrations: postgresql://postgres:postgres_password@postgres:5432/exam_proctoring_db
DATABASE_URL=
DATABASE_SYNC_URL=

# Redis Cache & Session Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT Security & Authentication
# IMPORTANT: Replace with a cryptographically random secret string in production (e.g., openssl rand -hex 32)
SECRET_KEY=exam_proctoring_dev_secret_key_at_least_32_characters_long_super_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ML Proctoring Service
ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://ml-service:8001

# Judge0 Code Execution Engine
JUDGE0_HOST=judge0-server
JUDGE0_PORT=2358
JUDGE0_API_URL=http://judge0-server:2358
JUDGE0_DB_USER=judge0
JUDGE0_DB_PASSWORD=judge0_db_password
JUDGE0_DB_NAME=judge0

# Frontend Configuration (exposed to browser client)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ML_SERVICE_URL=http://localhost:8001
VITE_JUDGE0_API_URL=http://localhost:2358
